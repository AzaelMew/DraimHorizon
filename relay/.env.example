# Public DNS name pointing at your own server. No scheme or path.
DOMAIN=relay.example.com
# Optional shared operator token, generate locally; never commit .env.
RELAY_ACCESS_TOKEN=
# Optional DeepL backup for clients with the relay token. Keep your personal key here.
RELAY_DEEPL_API_KEY=
# Manual service only: trusted TCP proxies allowed to supply X-Real-IP.
# Compose sets its dedicated Caddy /32 itself.
# RELAY_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
